{
  "name": "tablero-rol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["client"],
  "scripts": {
    "dev": "concurrently \"tsx watch src/server.ts\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client && tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "concurrently": "^9.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
