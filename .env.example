# Copia este archivo a `.env` y rellena los valores.
# Nunca subas el archivo `.env` real al repositorio.

# --- Persistencia (PostgreSQL) ---
# En Render se define a mano con la cadena de conexión de Neon
# (ver la sección "Base de datos (Neon)" del README).
# En local puedes dejar esta variable vacía para usar el repositorio en memoria.
DATABASE_URL=

# --- Sesiones ---
# Cadena aleatoria larga para firmar la cookie de sesión.
SESSION_SECRET=

# --- Primer administrador ---
# Se crea (o promociona) al arrancar el servidor si no existe, y siempre
# queda aprobado (status ACTIVE).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Almacenamiento de archivos (Cloudflare R2, compatible con S3) ---
# Si no se rellenan, los archivos se guardan en memoria y se pierden al
# reiniciar (solo desarrollo). Los metadatos siempre van a PostgreSQL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Tamaño máximo por archivo, en bytes (por defecto 15 MiB).
# ARCHIVO_MAX_BYTES=15728640
