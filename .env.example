# Copia este archivo a `.env` y rellena los valores.
# Nunca subas el archivo `.env` real al repositorio.

# --- Persistencia (PostgreSQL) ---
# En Render se enlaza automáticamente desde la base de datos.
# En local puedes dejar esta variable vacía para usar el repositorio en memoria.
DATABASE_URL=

# --- Sesiones ---
# Cadena aleatoria larga para firmar la cookie de sesión.
SESSION_SECRET=

# --- Primer administrador ---
# Se crea (o promociona) al arrancar el servidor si no existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=
