# Copia este archivo a `.env` y rellena los valores.
# Nunca subas el archivo `.env` real al repositorio.

# --- Persistencia (PostgreSQL) ---
# En Render se enlaza automáticamente desde la base de datos.
# En local puedes dejar esta variable vacía para usar el repositorio en memoria.
DATABASE_URL=

# --- Sesiones ---
# Cadena aleatoria larga para firmar la cookie de sesión.
SESSION_SECRET=

# --- URL pública de la aplicación ---
# Se usa para construir el callback de OAuth y los enlaces de confirmación.
# En local: http://localhost:8080 . En producción: la URL pública de Render.
APP_BASE_URL=http://localhost:8080

# --- OAuth con Google (Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Correo transaccional (Resend u otro proveedor con API key) ---
EMAIL_API_KEY=
EMAIL_FROM=

# --- Primer administrador ---
# Se crea (o promociona) al arrancar el servidor si no existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=
